      "parameters": {
        "language": "pythonNative",
        "pythonCode": "results = []\n\nfor item in _items:\n    data = item[\"json\"]\n\n    # Extract nested AI evaluation\n    output = data.get(\"output\", {})\n\n    # Get candidate score\n    score = output.get(\"ai_resume_score\", 0)\n\n    try:\n        score = float(str(score).split(\"/\")[0].strip())\n    except (ValueError, TypeError):\n        score = 0\n\n    # Categorize candidate\n    if score >= 7:\n        status = \"Shortlisted\"\n    elif score >= 5:\n        status = \"Under Review\"\n    else:\n        status = \"Rejected\"\n\n    # Add classification\n    data[\"Final Score\"] = score\n    data[\"Candidate Status\"] = status\n\n    results.append({\n        \"json\": data\n    })\n\nreturn results"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
